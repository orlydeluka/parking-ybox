# טוקן סודי – אותו טוקן מגדירים בקיצור הדרך באייפון. צרי מחרוזת אקראית ארוכה.
API_TOKEN=change-me-to-a-long-random-string

# לאן לשלוח את החשבוניות
MAIL_TO=orlyg@timlul.com
MAIL_FROM=orlyg@timlul.com

# פרטי שרת SMTP (דוגמה ל-Gmail / Google Workspace עם סיסמת אפליקציה)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orlyg@timlul.com
SMTP_PASS=app-password-here

# מילים שרק הודעות שמכילות אותן יטופלו (ריק = כל לינק). מופרד בפסיקים.
KEYWORDS=חשבונית,קבלה,invoice,receipt

PORT=3000
